# Testnet / local only. Never commit a filled-in .env.

# Base Sepolia (EAS is an OP Stack predeploy)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
EAS_ADDRESS=0x4200000000000000000000000000000000000021
SCHEMA_REGISTRY_ADDRESS=0x4200000000000000000000000000000000000020

# Optional: account that should end up as admin + issuer (defaults to the broadcasting wallet)
ADMIN=

# Optional: for `forge script --verify`
BASESCAN_API_KEY=

# Broadcast with a keystore, not a raw key:  forge script ... --account <name> --sender <addr>
# (create one with `cast wallet import <name> --interactive`)
