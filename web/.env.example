# All NEXT_PUBLIC_* values are shipped to the browser. Contract addresses and RPC URLs only. No keys.

# Base Sepolia RPC (leave empty to use viem's public default)
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=

# ChainCredID registry addresses, from `forge script script/Deploy.s.sol` output
NEXT_PUBLIC_REGISTRY_ADDRESS_BASE_SEPOLIA=
NEXT_PUBLIC_REGISTRY_ADDRESS_LOCAL=
